{
  "name": "tiny-civilization-simulator",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ship": "npm run build && node scripts/pages.mjs",
    "set-server": "node scripts/set-server.mjs",
    "server": "node --experimental-strip-types server/index.ts",
    "start": "node scripts/serve.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": { "typescript": "~5.9.3", "vite": "^7.1.12", "@types/node": "^22.18.0", "@types/ws": "^8.18.1" }
}
